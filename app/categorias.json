  "categorias": [
    { "id": "gpu", "nome": "Placa de vídeo", "grupo": "pecas", "icone": "ti-device-desktop",
      "serve": "Desenha as imagens dos jogos. É a peça que mais define em que qualidade e quantos FPS você joga.",
      "kabum": ["placa de video"], "menu": "Placa de vídeo \\(VGA\\)/Placa de vídeo", "zoom": ["placa de video"], "zoomCat": ["Placa de Video"],
      "re": "^placa de v[ií]deo|\\b(geforce|radeon)\\b|\\b(rtx|gtx)\\s?\\d{4}|\\brx\\s?\\d{4}" },
    { "id": "cpu", "nome": "Processador", "grupo": "pecas", "icone": "ti-cpu",
      "serve": "O cérebro do PC: roda o sistema, os programas e a lógica dos jogos. Precisa combinar com a placa-mãe (soquete AM4, AM5, LGA1700...).",
      "kabum": ["processador"], "menu": "^Hardware/Processadores", "zoom": ["processador"], "zoomCat": ["Processador"],
      "re": "^processador|^(amd )?ryzen [3579]|^intel core" },
    { "id": "placa-mae", "nome": "Placa-mãe", "grupo": "pecas", "icone": "ti-circuit-board",
      "serve": "Liga todas as peças. Define qual processador e qual memória (DDR4 ou DDR5) você pode usar.",
      "kabum": ["placa mae"], "menu": "Placas-mãe/Placa-Mãe", "zoom": ["placa mae"], "zoomCat": ["Placa Mãe"],
      "re": "^placa[- ]m[ãa]e" },
    { "id": "ram", "nome": "Memória RAM", "grupo": "pecas", "icone": "ti-cpu-2",
      "serve": "Memória de curto prazo: deixa abrir muitos programas e abas sem travar. Para jogos hoje, 16 GB é o mínimo e 32 GB é o confortável.",
      "kabum": ["memoria ram ddr4", "memoria ram ddr5"], "menu": "Memória RAM", "zoom": ["memoria ram"], "zoomCat": ["Memória RAM"],
      "re": "^mem[oó]ria (ram|ddr|gamer|desktop)|^mem[oó]ria .*\\bddr[45]\\b" },
    { "id": "ssd", "nome": "SSD", "grupo": "pecas", "icone": "ti-database",
      "serve": "Onde ficam guardados o sistema, os jogos e os arquivos. SSD NVMe é o mais rápido: o PC liga e os jogos carregam em segundos.",
      "kabum": ["ssd nvme", "ssd"], "menu": "Hardware/SSD/SSD (SATA|PCIe|M\\.2)", "zoom": ["ssd nvme", "ssd sata"], "zoomCat": ["SSD"],
      "re": "^ssd\\b|\\bssd (nvme|m\\.?2|sata)" },
    { "id": "fonte", "nome": "Fonte", "grupo": "pecas", "icone": "ti-plug",
      "serve": "Dá energia para tudo. Uma fonte boa (selo 80 Plus) protege as outras peças; a potência (W) precisa aguentar a placa de vídeo.",
      "kabum": ["fonte"], "menu": "Hardware/Fontes", "zoom": ["fonte atx"], "zoomCat": ["Fonte para PC", "Fonte ATX", "Fonte"],
      "re": "^fonte\\b.*\\d{3,4}\\s?w" },
    { "id": "gabinete", "nome": "Gabinete", "grupo": "pecas", "icone": "ti-box",
      "serve": "A caixa do PC. Precisa caber a placa-mãe e a placa de vídeo, e ter boa ventilação.",
      "kabum": ["gabinete gamer"], "menu": "Gabinetes/Gabinete", "zoom": ["gabinete gamer"], "zoomCat": ["Gabinete"],
      "re": "^gabinete" },
    { "id": "cooler", "nome": "Cooler", "grupo": "pecas", "icone": "ti-propeller",
      "serve": "Esfria o processador (air cooler ou water cooler) e o gabinete (fans). Menos calor = mais desempenho e menos barulho.",
      "kabum": ["water cooler", "air cooler"], "menu": "Hardware/Coolers/(Water|Air|FAN)", "zoom": ["water cooler"], "zoomCat": ["Cooler", "Water Cooler"],
      "re": "^(water ?cooler|air ?cooler|cooler|kit (de )?ventoinhas?|kit fans?|ventoinha|fan )" },
    { "id": "mouse", "nome": "Mouse", "grupo": "perifericos", "icone": "ti-mouse",
      "serve": "Para jogos, conta o sensor preciso e o peso leve. Sem fio de boa marca já tem atraso imperceptível.",
