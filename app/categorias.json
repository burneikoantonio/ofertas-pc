      "re": "^mouse\\b(?!\\s?pad)" },
    { "id": "teclado", "nome": "Teclado", "grupo": "perifericos", "icone": "ti-keyboard",
      "serve": "Teclado mecânico dura mais e responde melhor. Tamanhos menores (60%, 65%, TKL) deixam mais espaço para o mouse.",
      "kabum": ["teclado gamer"], "menu": "Periféricos/Teclado Gamer/(Com|Sem) Fio", "zoom": ["teclado gamer"], "zoomCat": ["Teclado"],
      "re": "^teclado" },
    { "id": "headset", "nome": "Headset", "grupo": "perifericos", "icone": "ti-headset",
      "serve": "Fone com microfone: ouvir passos nos jogos e falar com os amigos. Conforto importa em sessões longas.",
      "kabum": ["headset gamer"], "menu": "Periféricos/Headsets? Gamer|Periféricos/Headsets", "zoom": ["headset gamer"], "zoomCat": ["Headset", "Fone de Ouvido"],
      "re": "^headset|^fone (de ouvido )?(gamer|headset)" },
    { "id": "mousepad", "nome": "Mousepad", "grupo": "perifericos", "icone": "ti-rectangle",
      "serve": "Superfície do mouse. Os grandes (speed/control) ajudam na mira e protegem a mesa.",
      "kabum": ["mousepad"], "menu": "Periféricos/Mouse Pad", "zoom": [], "zoomCat": ["Mouse Pad"],
      "re": "^mouse ?pad" },
    { "id": "webcam", "nome": "Webcam e microfone", "grupo": "perifericos", "icone": "ti-camera",
      "serve": "Para chamadas de vídeo, aulas e stream. Microfone dedicado melhora muito a voz.",
      "kabum": ["webcam", "microfone streamer"], "menu": "Webcam e Videoconferência/Webcam|Streamer/Microfone|Áudio/Microfone", "zoom": ["webcam", "microfone usb"], "zoomCat": ["WebCam", "Microfone"],
      "re": "^webcam|^microfone" },
    { "id": "controle", "nome": "Controle", "grupo": "perifericos", "icone": "ti-device-gamepad",
      "serve": "Controle para PC e consoles. DualSense (PS5) e controle Xbox funcionam no PC também.",
      "kabum": ["controle"], "menu": "Games/(Acessórios Gamer/Joystick|Playstation/Controles|Xbox/Controles|Nintendo/Controles)", "zoom": ["controle dualsense", "controle xbox"], "zoomCat": ["Controle para Video Game", "Controle"],
      "re": "^controle|^joystick|dualsense" },
    { "id": "monitor", "nome": "Monitor", "grupo": "monitores", "icone": "ti-device-tv",
      "serve": "A tela. Para jogos, olhe a taxa de atualização (Hz: 144 ou mais é fluido) e a resolução (Full HD, 2K/QHD, 4K).",
      "kabum": ["monitor gamer", "monitor"], "menu": "Computadores/Monitores", "zoom": ["monitor gamer", "monitor"], "zoomCat": ["Monitor"],
      "re": "^monitor\\b" },
    { "id": "pc", "nome": "PC pronto e kits", "grupo": "prontos", "icone": "ti-device-desktop-analytics",
      "serve": "Computador já montado ou kit de upgrade (processador + placa-mãe + memória). Prático, mas compare com montar peça por peça.",
      "kabum": ["pc gamer", "kit upgrade"], "menu": "Computadores/PC|Kit Hardware/Kit Upgrade", "zoom": ["pc gamer"], "zoomCat": ["Computador", "PC"],
      "re": "^(pc gamer|computador|pichau kit|kit upgrade|.*kit upgrade)" },
    { "id": "notebook", "nome": "Notebook", "grupo": "prontos", "icone": "ti-device-laptop",
